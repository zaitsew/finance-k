# Both variables are optional. Uncomment to override the defaults.
# Nothing here is a secret.
#
# Where finance-k.sqlite lives. Default: ~/Library/Application Support/finance-k
# FINANCE_K_DATA_DIR=
#
# Idle EUR cash threshold for the BankJar link, in whole euros. Default: 2000.
# The Settings page value, once saved, overrides this.
# FINANCE_K_IDLE_CASH_EUR=
